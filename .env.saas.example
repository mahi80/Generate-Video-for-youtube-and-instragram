# SaaS mode settings. Copy to .env.saas and fill in, then either:
#   set -a; . ./.env.saas; set +a; ./webui-htmx.sh                       (app from .venv)
#   docker compose -f docker-compose.saas.yml --env-file .env.saas --profile app up -d --build
# Never commit .env.saas: it contains secrets.

# PostgreSQL started by docker-compose.saas.yml (port 55432 on this machine).
DATABASE_URL=postgresql://mpt:mpt-local-dev-password@127.0.0.1:55432/mpt
POSTGRES_PASSWORD=mpt-local-dev-password

# Random string used to sign login cookies: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that get the Studio, Settings and the admin dashboard.
ADMIN_EMAILS=you@gmail.com

# The address people use to open the app.
PUBLIC_BASE_URL=http://localhost:8510

# Local testing only: email sign-in without Google. Keep 0 in production.
DEV_LOGIN=0

# Set to 1 when served over HTTPS.
SECURE_COOKIES=0
